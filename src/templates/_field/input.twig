{% import "_includes/forms.twig" as forms %}

{# None of the three menus carries a visible label: each one's blank option
   doubles as its placeholder, so an empty menu still says what it sets. They
   keep an aria-label, since a placeholder isn't announced as a label. #}
{% set urlLabel = 'Readme File'|t('scribe') %}
{% set startLabel = 'Start From'|t('scribe') %}
{% set endLabel = 'End Before'|t('scribe') %}
{% set startPlaceholder = 'Start from…'|t('scribe') %}
{% set endPlaceholder = 'End before…'|t('scribe') %}

{# What the note standing in for the heading menus says, in each of the two
   cases that leave a chosen readme with no headings to offer. Empty while the
   menus themselves are showing, or before a readme is chosen. #}
{% set note = '' %}
{% if not value.isEmpty and headings is empty %}
    {% set note = readmeExists
        ? 'No headings found'|t('scribe')
        : 'Couldn’t load this readme'|t('scribe') %}
{% endif %}

{# Readme menu options: the placeholder and the saved value, nothing more.
   Building the repository list costs a GitHub request per hundred repos, and
   the menu isn't read until it's opened — so the field renders on what it
   already knows and the JS fills the rest in on first focus, replacing this
   stand-in option with the repository's own name and readme filename. #}
{% set repoOptions = [{ label: 'Select a readme file…'|t('scribe'), value: '' }] %}
{% if value.url %}
    {# Labelled with the repository's own name, which is what the fetched list
       calls it — so the menu reads the same before and after it loads, rather
       than rewriting itself under the editor as they open it. #}
    {% set repoOptions = repoOptions|merge([{
        label: value.url|split('/')|last ?: value.url,
        value: value.url,
    }]) %}
{% endif %}

{# Heading menu options: each menu's own placeholder plus every heading in the
   source. JS narrows End Before to the headings after Start From. #}
{% set headingOptions = [] %}
{% for h in headings %}
    {% set headingOptions = headingOptions|merge([{ label: h.label, value: h.value }]) %}
{% endfor %}

{% if not hasToken %}
    <p class="warning">{{ 'Set a GitHub token in <a href="{url}">Scribe’s settings</a> to use this field.'|t('scribe', { url: cpUrl('settings/plugins/scribe') })|raw }}</p>
    {# Preserve any saved values so editing + saving without a token doesn't wipe them. #}
    <input type="hidden" name="{{ name }}[url]" value="{{ value.url }}">
    <input type="hidden" name="{{ name }}[startFrom]" value="{{ value.startFrom }}">
    <input type="hidden" name="{{ name }}[endBefore]" value="{{ value.endBefore }}">
{% else %}
<div class="scribe">
<div class="scribe-field">
    <div class="scribe-repo">
        {% if isStatic %}
            {# Selectize hides the select it's given and replaces it on setup,
               but a static render discards the JS that would do it — so the
               menu has to be a plain one here. #}
            {{ forms.select({
                id: id ~ '-url',
                name: name ~ '[url]',
                options: repoOptions,
                value: value.url,
                inputAttributes: { aria: { label: urlLabel } },
            }) }}
        {% else %}
            {{ forms.selectize({
                id: id ~ '-url',
                name: name ~ '[url]',
                options: repoOptions,
                value: value.url,
                inputAttributes: { aria: { label: urlLabel } },
                selectizeOptions: { dropdownClass: 'scribe-dropdown' },
            }) }}
        {% endif %}
    </div>

    {# Hidden until there's a range to pick: no readme chosen, or one whose
       headings the menus would have nothing to offer from. #}
    <div class="scribe-range{{ headings is empty ? ' hidden' }}" data-scribe-range>
        <div class="scribe-col">
            {{ forms.select({
                id: id ~ '-startFrom',
                name: name ~ '[startFrom]',
                options: [{ label: startPlaceholder, value: '' }]|merge(headingOptions),
                value: value.startFrom,
                inputAttributes: { aria: { label: startLabel } },
            }) }}
        </div>
        <div class="scribe-col">
            {{ forms.select({
                id: id ~ '-endBefore',
                name: name ~ '[endBefore]',
                options: [{ label: endPlaceholder, value: '' }]|merge(headingOptions),
                value: value.endBefore,
                inputAttributes: { aria: { label: endLabel } },
            }) }}
        </div>
    </div>

    <div class="scribe-note{{ note ? '' : ' hidden' }}" role="status" data-scribe-note>{{ note }}</div>

    {# Only in the layout while a readme is being fetched, trailing whatever is
       last on the row — End Before, the note that stands in for it, or the
       readme picker while neither is showing. #}
    <div class="spinner" role="status" aria-live="polite" aria-label="{{ 'Loading'|t('app') }}" data-scribe-spinner></div>
</div>
{% if showPreview %}
{# Out of the field until there's something to preview: no readme chosen, or one
   that couldn't be fetched — which the note above already accounts for, and
   would leave nothing here but an empty pane. #}
<details class="scribe-preview{{ not readmeExists ? ' hidden' }}" data-scribe-preview{% if readmeExists and previewOpen %} open{% endif %}>
    <summary>{{ 'Preview'|t('scribe') }}</summary>
    <div class="scribe-preview-body prose" data-scribe-preview-body>{{ previewHtml|raw }}</div>
</details>
{% endif %}
</div>
{% endif %}
