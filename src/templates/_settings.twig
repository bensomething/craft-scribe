{% import "_includes/forms.twig" as forms %}

{{ forms.autosuggestField({
    label: 'GitHub Token'|t('scribe'),
    instructions: 'Required. A GitHub personal access token — the field lists this account’s repositories (public and private) and validates against it. Falls back to the `GITHUB_TOKEN` environment variable.'|t('scribe'),
    required: true,
    id: 'token',
    name: 'token',
    value: settings.token,
    suggestEnvVars: true,
}) }}

{{ forms.textField({
    label: 'Cache Duration'|t('scribe'),
    instructions: 'How many seconds to cache fetched data.'|t('scribe'),
    id: 'cacheDuration',
    name: 'cacheDuration',
    value: settings.cacheDuration,
    type: 'number',
    size: 8,
    unit: 'seconds'|t('scribe'),
}) }}

{{ forms.textField({
    label: 'Code Block Template'|t('scribe'),
    instructions: 'Optional site template used to render each code block, given `code` and `language`. Leave blank for a minimal `<pre><code>`.'|t('scribe'),
    id: 'codeBlockTemplate',
    name: 'codeBlockTemplate',
    value: settings.codeBlockTemplate,
    placeholder: '_partials/code/remote',
}) }}
